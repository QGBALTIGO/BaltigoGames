# Único segredo obrigatório em produção:
BOT_TOKEN=

# O Railway fornece RAILWAY_PUBLIC_DOMAIN automaticamente.
# APP_URL só é necessário se quiser forçar um domínio diferente.
# APP_URL=https://games.seudominio.com

# Fonte dos jogos Sausi-7. Pode ser trocada por um espelho próprio depois.
UPSTREAM_GAMES_BASE=https://sausi-7.github.io/games

# Mirror fixado e banco persistente privado (recomendados na VPS).
# UPSTREAM_LOCAL_DIR=/opt/baltigogames/upstream/c97ef8b
# DATABASE_PATH=/var/lib/baltigogames/leaderboard.sqlite
